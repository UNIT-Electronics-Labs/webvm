#!/bin/sh
set -eu

export HOSTNAME=localhost
export XAUTHORITY="$HOME/.Xauthority"
# CheerpX provides a virtual display without 3D acceleration.  Mesa's
# software path avoids trying to load the unavailable CheerpX KMS driver.
export LIBGL_ALWAYS_SOFTWARE=1
mkdir -p "$HOME/.config/openbox"

# WebVM can restart the configured command while the previous Xorg process is
# still alive, or leave its lock behind after a crash.  Reuse a live display;
# remove only stale runtime files so xinit can start cleanly on the next run.
X_LOCK=/tmp/.X0-lock
X_SOCKET=/tmp/.X11-unix/X0
if [ -f "$X_LOCK" ]; then
	X_PID=$(tr -cd '0-9' < "$X_LOCK" 2>/dev/null || true)
	if [ -n "$X_PID" ] && kill -0 "$X_PID" 2>/dev/null; then
		export DISPLAY=:0
		exec openbox-session
	fi
	rm -f "$X_LOCK" "$X_SOCKET" 2>/dev/null || true
fi

cat > "$HOME/.xinitrc" <<'EOF'
exec openbox-session
EOF

cat > "$HOME/.config/openbox/autostart" <<'EOF'
geany /home/user/ch552/examples/blink/main.c &
xterm -title "CH552 SDCC" -e sh -lc 'cd /home/user/ch552/examples/blink; exec bash --login' &
EOF

# startx from Debian creates xauth entries using the bare display ":0".
# WebVM's minimal hostname setup rejects that form, so invoke xinit directly.
exec xinit "$HOME/.xinitrc" -- /usr/bin/Xorg :0 -nolisten tcp
