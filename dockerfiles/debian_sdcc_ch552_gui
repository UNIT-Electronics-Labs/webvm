FROM --platform=linux/386 docker.io/i386/debian:bookworm-slim
ARG DEBIAN_FRONTEND=noninteractive
ARG CH55X_SDK_REF=main

# Lightweight graphical environment: Openbox, Geany and xterm.
RUN apt-get clean && apt-get update && apt-get -y upgrade && \
  apt-get install -y --no-install-recommends \
    apt-utils binutils ca-certificates curl dbus-x11 geany git make \
    openbox python3 python3-usb sdcc unzip xinit xterm xserver-xorg-core \
    libgl1-mesa-dri && \
  rm -rf /var/lib/apt/lists/*

COPY dockerfiles/start_ch552_gui /tmp/start_ch552_gui
COPY dockerfiles/xorg_ch552.conf /etc/X11/xorg.conf.d/20-cheerpx.conf

RUN git clone --depth 1 --branch "${CH55X_SDK_REF}" \
    https://github.com/UNIT-Electronics-MX/unit_ch55x_sdk.git /opt/unit_ch55x_sdk

# Keep the GUI image's build behavior identical to the terminal image.
RUN find /opt/unit_ch55x_sdk -name Makefile -exec sed -i \
    -e 's#@$(PACK_HEX) $< > $@#@cp $< $@#' \
    -e 's#OBJCOPY[[:space:]]*= objcopy#OBJCOPY    = sdobjcopy#' \
    -e 's#@$(OBJCOPY) -I ihex -O binary $< $@#@tmp=$<.regular; cp -L $< $$tmp \&\& ($(OBJCOPY) -I ihex -O binary $$tmp $@ || (rm -f $@; makebin -p $$tmp $@)); status=$$?; rm -f $$tmp; exit $$status#' {} +

RUN useradd -m user && echo "user:password" | chpasswd && \
  mkdir -p /home/user/ch552 && \
  cp -a /opt/unit_ch55x_sdk/. /home/user/ch552/ && \
  cp /tmp/start_ch552_gui /usr/local/bin/start_ch552_gui && \
  chmod +x /usr/local/bin/start_ch552_gui && \
  chown -R user:user /home/user/ch552 /usr/local/bin/start_ch552_gui && \
  test -f /home/user/ch552/examples/blink/main.c && \
  runuser -u user -- test -w /home/user/ch552/examples/blink/main.c

WORKDIR /home/user/ch552/examples/blink
ENV HOME="/home/user" TERM="xterm" USER="user" SHELL="/bin/bash" \
  EDITOR="geany" LANG="C.UTF-8" SDCC_HOME="/usr/share/sdcc"
RUN echo 'root:password' | chpasswd
CMD [ "/usr/local/bin/start_ch552_gui" ]
